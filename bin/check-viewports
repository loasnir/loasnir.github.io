#!/usr/bin/env node
// 幅のレンジを横断して「記事が読める状態か」を判定する検収スクリプト。
// 中間帯（折りたたみ端末・タブレット縦）の崩れを目視でしか拾えなかったため、
// 判定を機械化する。対象ページは content/ から自動で列挙する。
import { chromium } from "playwright-core"
import { mkdir, readdir } from "node:fs/promises"
import path from "node:path"

const WIDTHS = [360, 390, 600, 820, 1024, 1280]
const HEIGHT = 844

// mdBook は content のパスがそのまま .html になる。index.md だけディレクトリの
// インデックスとして残るので、そこだけ末尾スラッシュの形で叩く
async function contentPaths(dir = "content", prefix = "") {
  const out = []
  for (const e of await readdir(dir, { withFileTypes: true })) {
    if (e.isDirectory() && e.name === "notes" && prefix === "") continue
    if (e.isDirectory()) out.push(...(await contentPaths(path.join(dir, e.name), `${prefix}${e.name}/`)))
    else if (e.name.endsWith(".md")) {
      const name = e.name.slice(0, -3)
      // SUMMARY.md は目次の定義、404.md は存在しないパス用なので検査しない
      if (name === "SUMMARY" || name === "404") continue
      out.push(name === "index" ? `/${prefix}` : `/${prefix}${name}.html`)
    }
  }
  return out
}


function parseArgs(argv) {
  const opts = { base: "http://localhost:8080", pages: null, screenshots: null }
  const rest = []
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === "--screenshots") opts.screenshots = argv[++i]
    else if (argv[i] === "--pages") opts.pages = argv[++i].split(",")
    else if (argv[i] === "--help" || argv[i] === "-h") opts.help = true
    else rest.push(argv[i])
  }
  if (rest.length > 0) opts.base = rest[0].replace(/\/$/, "")
  return opts
}

const USAGE = `使い方: bin/check-viewports [ベースURL] [--pages /a,/b] [--screenshots ディレクトリ]

  ベースURL     既定 http://localhost:8080（本番は https://loasnir.github.io）
  --pages       検査するパスをカンマ区切りで指定（既定: content/ から自動列挙）
  --screenshots 指定したディレクトリに {ページ}-{幅}.png を保存する

  幅 ${WIDTHS.join(" / ")} を高さ ${HEIGHT} で検査し、1 件でも NG があれば exit 1。`

// ブラウザ内で測る。判定そのものは Node 側で行い、ここは数値の取得だけに絞る
function measure() {
  const rect = (sel) => {
    const el = document.querySelector(sel)
    if (!el) return null
    const box = el.getBoundingClientRect()
    return { top: Math.round(box.top), width: Math.round(box.width) }
  }
  return {
    title: rect("main h1"),
    article: rect("main"),
    scrollWidth: document.documentElement.scrollWidth,
    innerWidth: window.innerWidth,
  }
}

function judge(m, height) {
  return [
    // (a) 記事タイトルが初期表示で見えているか
    {
      key: "title",
      ok: m.title !== null && m.title.top > 0 && m.title.top < height,
      detail: m.title ? `top=${m.title.top}` : "見つからない",
    },
    // (b) 横スクロールが出ていないか
    {
      key: "hscroll",
      ok: m.scrollWidth <= m.innerWidth,
      detail: `${m.scrollWidth}/${m.innerWidth}`,
    },
    // (c) 本文が画面内に収まっているか
    {
      key: "article",
      ok: m.article !== null && m.article.width <= m.innerWidth,
      detail: m.article ? `w=${m.article.width}` : "見つからない",
    },
  ]
}

const opts = parseArgs(process.argv.slice(2))
if (opts.help) {
  console.log(USAGE)
  process.exit(0)
}
const pages = opts.pages ?? (await contentPaths()).sort()
if (opts.screenshots) await mkdir(opts.screenshots, { recursive: true })

const browser = await chromium.launch()
const rows = []
for (const width of WIDTHS) {
  const ctx = await browser.newContext({ viewport: { width, height: HEIGHT }, locale: "ja-JP" })
  for (const pagePath of pages) {
    const page = await ctx.newPage()
    await page.goto(opts.base + pagePath, { waitUntil: "networkidle" })
    rows.push({ width, pagePath, checks: judge(await page.evaluate(measure), HEIGHT) })
    if (opts.screenshots) {
      const name = (pagePath.replace(/^\/|\/$/g, "") || "index").replace(/\//g, "-")
      await page.screenshot({ path: path.join(opts.screenshots, `${name}-${width}.png`) })
    }
    await page.close()
  }
  await ctx.close()
}
await browser.close()

const pad = (s, n) => String(s) + " ".repeat(Math.max(0, n - [...String(s)].length))
console.log(`対象: ${opts.base}（${pages.length} ページ × ${WIDTHS.length} 幅）`)
console.log(pad("幅", 6) + pad("ページ", 38) + "title       hscroll       article")
for (const { width, pagePath, checks } of rows) {
  console.log(
    pad(width, 6) + pad(pagePath, 38) + checks.map((c) => pad(`${c.ok ? "OK" : "NG"} ${c.detail}`, 14)).join(""),
  )
}

const ng = rows.filter((r) => r.checks.some((c) => !c.ok))
if (ng.length === 0) {
  console.log(`\n全 ${rows.length} 件 OK`)
  process.exit(0)
}
console.log(`\nNG ${ng.length} 件 / 全 ${rows.length} 件`)
for (const { width, pagePath, checks } of ng) {
  console.log(`  ${width} ${pagePath}: ${checks.filter((c) => !c.ok).map((c) => `${c.key}(${c.detail})`).join(", ")}`)
}
process.exit(1)

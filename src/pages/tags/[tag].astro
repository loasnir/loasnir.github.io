---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import { toSlug } from "../../slug"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  const tags = new Set(pages.flatMap((p) => p.data.tags ?? []))
  return [...tags].map((tag) => ({
    params: { tag },
    props: { entries: pages.filter((p) => p.data.tags?.includes(tag)) },
  }))
}

const { tag } = Astro.params
const { entries } = Astro.props
---

<Base title={`タグ: ${tag}`}>
  <article>
    <h1>タグ: {tag}</h1>
    <ul class="children">
      {
        entries.map((entry) => (
          <li>
            <a href={`/${toSlug(entry.id)}/`}>{entry.data.title}</a>
            {entry.data.description && <p class="child-desc">{entry.data.description}</p>}
          </li>
        ))
      }
    </ul>
    <p><a href="/tags/">タグ一覧へ</a></p>
  </article>
</Base>

---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"

const pages = await getCollection("pages")
const counts = new Map<string, number>()
for (const p of pages) for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1)
const tags = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b))
---

<Base title="タグ" description="タグごとにページをまとめています。">
  <article>
    <h1>タグ</h1>
    <p class="description">タグごとにページをまとめています。</p>
    <ul class="children">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tag}/`}>{tag}</a>
            <p class="child-desc">{count} ページ</p>
          </li>
        ))
      }
    </ul>
  </article>
</Base>

---
import { getCollection, render } from "astro:content"
import Base from "../layouts/Base.astro"
import { toSlug } from "../slug"
import { REDIRECTS } from "../redirects"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  return [
    ...pages.map((entry) => ({ params: { slug: toSlug(entry.id) }, props: { entry } })),
    ...Object.entries(REDIRECTS).map(([slug, redirectTo]) => ({
      params: { slug },
      props: { redirectTo },
    })),
  ]
}

const { entry, redirectTo } = Astro.props

const rendered = entry ? await render(entry) : null
const Content = rendered?.Content

// フォルダの index ページでは、そのフォルダ配下のページを一覧にする。
// glob loader が foo/index.md の id を "foo" にするため、
// index かどうかは id からは判らない。子を持つかどうかで判定する
const slug = entry ? toSlug(entry.id) : undefined
const children =
  entry && slug && entry.data.showChildren
    ? (await getCollection("pages"))
        .filter((p) => p.id.startsWith(`${slug}/`))
        .sort((a, b) => a.id.localeCompare(b.id))
    : []
---

{
  redirectTo ? (
    <Base title="移動しました" redirectTo={redirectTo}>
      <article>
        <h1>移動しました</h1>
        <p>
          このページは <a href={redirectTo}>{redirectTo}</a> に移りました。
        </p>
      </article>
    </Base>
  ) : (
    <Base title={entry.data.title} description={entry.data.description}>
      <article>
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="description">{entry.data.description}</p>}
        <Content />
        {children.length > 0 && (
          <ul class="children">
            {children.map((child) => (
              <li>
                <a href={`/${toSlug(child.id)}/`}>{child.data.title}</a>
                {child.data.description && <p class="child-desc">{child.data.description}</p>}
              </li>
            ))}
          </ul>
        )}
      </article>
    </Base>
  )
}
